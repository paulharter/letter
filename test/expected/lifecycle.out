    ('vip', 'a0000000-0000-0000-0000-000000000001'),
    ('vip', 'a0000000-0000-0000-0000-000000000002');
SELECT role, right(user_id, 4) AS who FROM letter.roles ORDER BY 1, 2;
  role  | who  
--------+------
 member | 0001
 member | 0002
 vip    | 0001
 vip    | 0002
(4 rows)

