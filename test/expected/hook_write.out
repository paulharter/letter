 t2    | closed
(2 rows)

DROP TABLE tickets;
NOTICE:  letter: dropped table public.tickets: removed 4 grant(s), 0 rule(s), 0 membership(s)
SET letter.bypass = off;
\set VERBOSITY default
-- Cleanup
RESET letter.user_id;
RESET letter.enforce_reads;
DROP FUNCTION truth();
DROP TABLE team_members, notes, projects, users CASCADE;
NOTICE:  letter: dropped table public.projects: removed 10 grant(s), 1 rule(s), 0 membership(s)
DROP EXTENSION letter CASCADE;
