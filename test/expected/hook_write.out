(1 row)

DELETE FROM tickets WHERE state = 'closed';                              -- nothing to delete
UPDATE tickets SET state = 'closed' WHERE title = 't1!' RETURNING title, state;   -- allowed; the row returned is already hidden
 title | state 
-------+-------
       | 
