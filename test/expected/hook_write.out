-- ============================================================
-- 3. SET reads a hidden column: NULL is written (D2).
-- ============================================================
UPDATE notes SET body = extra WHERE id = 'c0000000-0000-0000-0000-000000000001';
SELECT * FROM truth() WHERE tbl = 'notes';
