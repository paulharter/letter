-- ============================================================
-- 4. Every accepted algorithm, with the whole key set; a key of the
--    wrong type is skipped, not tried.
-- ============================================================
SELECT set_config('letter.jwt_keys', :'key_all', false) IS NOT NULL AS keys_set;
 keys_set 
----------
 t
(1 row)

