(1 row)

SET letter.jwt_issuer = 'https://issuer.test';
SET letter.jwt_audience = 'letter';
-- ============================================================
-- 1. A good token, for the session and for a transaction. In the
--    default mode login() sets letter.user_id, and enforcement follows
--    the setting as it always does.
-- ============================================================
SELECT letter.login(:'rs256_ok', false);
 login 
-------
 alice
(1 row)

SELECT letter.user_id();
 user_id 
---------
 alice
(1 row)

SHOW letter.user_id;
 letter.user_id 
----------------
 alice
(1 row)

SET letter.bypass = on;
CREATE TABLE diary (id int PRIMARY KEY, owner text, body text);
INSERT INTO diary VALUES (1, 'alice', 'hers'), (2, 'bob', 'his');
SELECT letter.grant_global('select', 'public.diary', 'any_user', ARRAY['*'], if := 'owner = letter.user_id()');
 grant_global 
--------------
 t
(1 row)

RESET letter.bypass;
SELECT body FROM diary;                       -- alice's row, through the setting login() made
 body 
------
 hers
(1 row)

SET letter.user_id = 'bob';                   -- the setting is the identity here: the application may still change it
SELECT body FROM diary;
 body 
------
 his
(1 row)

SET letter.bypass = on;
DROP TABLE diary;
NOTICE:  letter: dropped table public.diary: removed 1 grant(s), 0 rule(s), 0 membership(s)
RESET letter.bypass;
RESET letter.user_id;
BEGIN;
SELECT letter.login(:'rs256_ok');
 login 
-------
 alice
(1 row)

SELECT letter.user_id();
 user_id 
---------
 alice
(1 row)

COMMIT;
SELECT letter.user_id() IS NULL AS gone_with_the_transaction;
 gone_with_the_transaction 
---------------------------
 t
(1 row)

-- ============================================================
-- 2. Every way a token is rejected.
-- ============================================================
SELECT letter.login(:'rs256_expired');
ERROR:  letter: token rejected: expired
SELECT letter.login(:'rs256_nbf_future');
ERROR:  letter: token rejected: not yet valid
SELECT letter.login(:'rs256_wrong_iss');
ERROR:  letter: token rejected: wrong issuer
SELECT letter.login(:'rs256_wrong_aud');
ERROR:  letter: token rejected: wrong audience
SELECT letter.login(:'rs256_wrong_key');
ERROR:  letter: token rejected: bad signature
SELECT letter.login(:'rs256_tampered');
ERROR:  letter: token rejected: bad signature
SELECT letter.login(:'rs256_no_sub');
ERROR:  letter: token rejected: no sub claim
SELECT letter.login(:'rs256_numeric_sub');
ERROR:  letter: token rejected: the sub claim is not a non-empty string
SELECT letter.login(:'rs256_no_exp');
ERROR:  letter: token rejected: no exp claim
SELECT letter.login(:'none_alg');
ERROR:  letter: token rejected: algorithm none is not accepted (RS256/384/512, ES256/384, EdDSA)
SELECT letter.login(:'hs256_pubkey');
ERROR:  letter: token rejected: algorithm HS256 is not accepted (RS256/384/512, ES256/384, EdDSA)
SELECT letter.login(:'es256_ok');            -- an RSA key never verifies an ES256 token
ERROR:  letter: token rejected: bad signature
SELECT letter.login(:'garbage');
ERROR:  letter: token rejected: malformed base64url
SELECT letter.login(:'two_parts');
ERROR:  letter: token rejected: not a JWT (three segments expected)
SELECT letter.login('');
ERROR:  letter: token rejected: not a JWT (three segments expected)
SELECT letter.user_id() IS NULL AS still_nobody;
 still_nobody 
--------------
 t
(1 row)

