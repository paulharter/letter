-- ============================================================
-- Test 6: letter.user_id() — the user id, NULL when unset
-- ============================================================
RESET letter.user_id;
SELECT letter.user_id() IS NULL AS unset;
 unset 
-------
 t
(1 row)

SET letter.user_id = 'a0000000-0000-0000-0000-000000000001';
SELECT letter.user_id(), letter.user_id()::uuid = 'a0000000-0000-0000-0000-000000000001' AS castable;
               user_id                | castable 
--------------------------------------+----------
 a0000000-0000-0000-0000-000000000001 | t
(1 row)

RESET letter.user_id;
-- Clean up
DROP TABLE team_members CASCADE;
NOTICE:  letter: dropped table public.team_members: removed 1 grant(s), 1 assignment(s), 0 role(s)
NOTICE:  letter: removed the update grant to "editor" on public.projects (column "status"): column "status" of public.projects no longer exists
DROP TABLE projects CASCADE;
NOTICE:  letter: dropped table public.projects: removed 5 grant(s), 0 assignment(s), 0 role(s)
DROP TABLE users CASCADE;
DROP EXTENSION letter CASCADE;
