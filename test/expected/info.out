-- Test: info/debug functions
CREATE EXTENSION letter;
-- Bypass enforcement for this test (we're testing info functions, not enforcement)
SET letter.bypass = true;
-- Set up application tables and data
CREATE TABLE users (
    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    name TEXT NOT NULL
);
CREATE TABLE projects (
    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    name TEXT NOT NULL
);
CREATE TABLE team_members (
    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    project_id uuid NOT NULL REFERENCES projects(id) ON DELETE CASCADE,
    role TEXT NOT NULL
);
INSERT INTO users (id, name) VALUES
    ('a0000000-0000-0000-0000-000000000001', 'Alice'),
    ('a0000000-0000-0000-0000-000000000002', 'Bob');
INSERT INTO projects (id, name) VALUES
    ('b0000000-0000-0000-0000-000000000001', 'Project Alpha'),
    ('b0000000-0000-0000-0000-000000000002', 'Project Beta');
-- Set up grants
SELECT letter.grant('select', 'public.projects', 'viewer', ARRAY['*'], '', NULL, NULL);
 grant 
-------
 t
(1 row)

SELECT letter.grant('select', 'public.projects', 'editor', ARRAY['*'], '', NULL, NULL);
 grant 
-------
 t
(1 row)

SELECT letter.grant('update', 'public.projects', 'editor', ARRAY['name', 'status'], 'public.projects', NULL, NULL);
 grant 
-------
 t
(1 row)

SELECT letter.grant('delete', 'public.projects', 'admin', ARRAY['*'], '', NULL, NULL);
 grant 
-------
 t
(1 row)

SELECT letter.grant('insert', 'public.projects', 'admin', ARRAY['*'], '', NULL, NULL);
 grant 
-------
 t
(1 row)

SELECT letter.grant('select', 'public.team_members', 'editor', ARRAY['*'], 'public.projects', NULL, NULL);
 grant 
-------
 t
(1 row)

-- Set up assignments
SELECT letter.assign('public.team_members', 'user_id', 'public.projects',
    role_name := NULL, role_column := 'role', if_fn := NULL);
 assign 
--------
 t
(1 row)

-- Create some roles via assignment
INSERT INTO team_members (user_id, project_id, role) VALUES
    ('a0000000-0000-0000-0000-000000000001', 'b0000000-0000-0000-0000-000000000001', 'editor'),
    ('a0000000-0000-0000-0000-000000000001', 'b0000000-0000-0000-0000-000000000002', 'viewer'),
    ('a0000000-0000-0000-0000-000000000002', 'b0000000-0000-0000-0000-000000000001', 'admin');
-- ============================================================
-- Test 1: list_grants() - all grants grouped by role
-- ============================================================
SELECT * FROM letter.list_grants() ORDER BY role, on_table, privilege, column_name;
  role  | privilege |      on_table       | column_name |      scope      | using_path | check_fn 
--------+-----------+---------------------+-------------+-----------------+------------+----------
 admin  | delete    | public.projects     | *           |                 |            | 
 admin  | insert    | public.projects     | *           |                 |            | 
 editor | select    | public.projects     | *           |                 |            | 
 editor | update    | public.projects     | name        | public.projects |            | 
 editor | update    | public.projects     | status      | public.projects |            | 
 editor | select    | public.team_members | *           | public.projects |            | 
 viewer | select    | public.projects     | *           |                 |            | 
(7 rows)

-- ============================================================
-- Test 2: list_grants(role) - grants for a specific role
-- ============================================================
SELECT * FROM letter.list_grants('editor') ORDER BY on_table, privilege, column_name;
  role  | privilege |      on_table       | column_name |      scope      | using_path | check_fn 
--------+-----------+---------------------+-------------+-----------------+------------+----------
 editor | select    | public.projects     | *           |                 |            | 
 editor | update    | public.projects     | name        | public.projects |            | 
 editor | update    | public.projects     | status      | public.projects |            | 
 editor | select    | public.team_members | *           | public.projects |            | 
(4 rows)

-- ============================================================
-- Test 3: user_permissions(user_id) - all permissions for a user
-- ============================================================
SELECT * FROM letter.user_permissions('a0000000-0000-0000-0000-000000000001')
    ORDER BY on_table, privilege, column_name, scope_table, scope_id;
  role  | privilege |      on_table       | column_name |      scope      |   scope_table   |               scope_id               | using_path | check_fn 
--------+-----------+---------------------+-------------+-----------------+-----------------+--------------------------------------+------------+----------
 editor | select    | public.projects     | *           |                 | public.projects | b0000000-0000-0000-0000-000000000001 |            | 
 viewer | select    | public.projects     | *           |                 | public.projects | b0000000-0000-0000-0000-000000000002 |            | 
 editor | update    | public.projects     | name        | public.projects | public.projects | b0000000-0000-0000-0000-000000000001 |            | 
 editor | update    | public.projects     | status      | public.projects | public.projects | b0000000-0000-0000-0000-000000000001 |            | 
 editor | select    | public.team_members | *           | public.projects | public.projects | b0000000-0000-0000-0000-000000000001 |            | 
(5 rows)

