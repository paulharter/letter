SELECT letter.read_policy('public.comments') AS sql \gset
SELECT show_sql(:'sql') AS sql_shown \gset
\echo :sql_shown
SELECT b.id,
       CASE WHEN g1h1.project_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('editor', 'viewer') AND r.scope_table = <projects>)
              OR b.task_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('assignee') AND r.scope_table = <tasks>)
            THEN b.task_id END AS task_id,
       NULL::integer AS "........pg.dropped.3........",
       b.author,
       CASE WHEN g1h1.project_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('editor') AND r.scope_table = <projects>)
              OR b.task_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('assignee') AND r.scope_table = <tasks>)
            THEN b.body END AS body
FROM public.comments b
LEFT JOIN public.tasks g1h1 ON g1h1.id = b.task_id
WHERE (SELECT EXISTS (SELECT 1 FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('auditor') AND r.scope_table IS NULL))
UNION ALL
SELECT b.id,
       b.task_id,
       NULL::integer AS "........pg.dropped.3........",
       CASE WHEN (SELECT EXISTS (SELECT 1 FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('auditor') AND r.scope_table IS NULL))
              OR g1h1.project_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('viewer') AND r.scope_table = <projects>)
            THEN b.author END AS author,
       CASE WHEN g1h1.project_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('editor') AND r.scope_table = <projects>)
              OR b.task_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('assignee') AND r.scope_table = <tasks>)
            THEN b.body END AS body
FROM public.comments b
LEFT JOIN public.tasks g1h1 ON g1h1.id = b.task_id
WHERE g1h1.project_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('editor', 'viewer') AND r.scope_table = <projects>)
  AND NOT (SELECT EXISTS (SELECT 1 FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('auditor') AND r.scope_table IS NULL))
UNION ALL
SELECT b.id,
       b.task_id,
       NULL::integer AS "........pg.dropped.3........",
       CASE WHEN (SELECT EXISTS (SELECT 1 FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('auditor') AND r.scope_table IS NULL))
              OR g1h1.project_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('viewer') AND r.scope_table = <projects>)
            THEN b.author END AS author,
