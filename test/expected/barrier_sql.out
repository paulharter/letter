(1 row)

SELECT letter.read_policy('public.tasks') AS sql \gset
SELECT show_sql(:'sql') AS sql_shown \gset
\echo :sql_shown
SELECT b.id,
       b.project_id,
       b.title,
       NULL::character varying(10) AS estimate
FROM public.tasks b
WHERE b.project_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('editor') AND r.scope_table = <projects>)
CREATE VIEW v_tasks WITH (security_barrier) AS :sql;
SET letter.user_id = 'alice';
SELECT title, estimate FROM v_tasks ORDER BY title;
