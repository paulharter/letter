CREATE FUNCTION if_qual_rows(tbl regclass) RETURNS bigint LANGUAGE plpgsql AS $$
DECLARE n bigint;
BEGIN
    EXECUTE format('SELECT count(*) FROM %s b %s', tbl,
                   split_part(letter.write_policy(tbl), E'\n', 1)) INTO n;
    RETURN n;
END $$;
