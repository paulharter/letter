SELECT b.id,
       CASE WHEN b.org_id IN (SELECT r.scope_id::bigint FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('member') AND r.scope_table = <orgs>)
              OR b.id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('editor') AND r.scope_table = <projects>)
            THEN b.org_id END AS org_id,
       b.name,
       CASE WHEN b.org_id IN (SELECT r.scope_id::bigint FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('member') AND r.scope_table = <orgs>)
              OR b.id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('editor') AND r.scope_table = <projects>)
            THEN b.status END AS status
FROM public.projects b
WHERE (SELECT EXISTS (SELECT 1 FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('auditor') AND r.scope_table IS NULL))
UNION ALL
SELECT b.id,
       b.org_id,
       CASE WHEN (SELECT EXISTS (SELECT 1 FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('auditor') AND r.scope_table IS NULL))
              OR b.id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('editor') AND r.scope_table = <projects>)
            THEN b.name END AS name,
       b.status
FROM public.projects b
WHERE b.org_id IN (SELECT r.scope_id::bigint FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('member') AND r.scope_table = <orgs>)
  AND NOT (SELECT EXISTS (SELECT 1 FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('auditor') AND r.scope_table IS NULL))
UNION ALL
SELECT b.id,
       b.org_id,
       b.name,
       b.status
FROM public.projects b
WHERE b.id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('editor') AND r.scope_table = <projects>)
  AND NOT (SELECT EXISTS (SELECT 1 FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('auditor') AND r.scope_table IS NULL))
  AND (b.org_id IN (SELECT r.scope_id::bigint FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('member') AND r.scope_table = <orgs>)) IS NOT TRUE
