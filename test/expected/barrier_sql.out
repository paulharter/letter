SELECT show_sql(:'sql') AS sql_shown \gset
\echo :sql_shown
SELECT b.id,
       CASE WHEN (b.project_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('editor') AND r.scope_table = <projects>) AND ((b.author = letter.user_id())))
              OR (b.project_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('editor') AND r.scope_table = <projects>) AND ((b.kind <> 'private'::text)))
            THEN b.project_id END AS project_id,
       CASE WHEN (b.project_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('editor') AND r.scope_table = <projects>) AND ((b.author = letter.user_id())))
            THEN b.author END AS author,
       CASE WHEN (b.project_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('editor') AND r.scope_table = <projects>) AND ((b.author = letter.user_id())))
              OR (b.project_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('editor') AND r.scope_table = <projects>) AND ((b.kind <> 'private'::text)))
            THEN b.body END AS body,
       b.kind
FROM public.notes b
WHERE ((SELECT EXISTS (SELECT 1 FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('auditor') AND r.scope_table IS NULL)) AND (public.is_public(b.*)))
UNION ALL
