FROM public.comments b
LEFT JOIN public.tasks g1h1 ON g1h1.id = b.task_id
WHERE b.task_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('assignee') AND r.scope_table = <tasks>)
  AND NOT (SELECT EXISTS (SELECT 1 FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('auditor') AND r.scope_table IS NULL))
  AND (g1h1.project_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('editor', 'viewer') AND r.scope_table = <projects>)) IS NOT TRUE
