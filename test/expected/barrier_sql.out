FROM public.notes b
WHERE (b.project_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('editor') AND r.scope_table = <projects>) AND ((b.author = letter.user_id())))
  AND NOT ((SELECT EXISTS (SELECT 1 FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('auditor') AND r.scope_table IS NULL)) AND (public.is_public(b.*)))
UNION ALL
SELECT b.id,
       b.project_id,
       CASE WHEN (b.project_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('editor') AND r.scope_table = <projects>) AND ((b.author = letter.user_id())))
            THEN b.author END AS author,
       b.body,
       CASE WHEN ((SELECT EXISTS (SELECT 1 FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('auditor') AND r.scope_table IS NULL)) AND (public.is_public(b.*)))
              OR (b.project_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('editor') AND r.scope_table = <projects>) AND ((b.author = letter.user_id())))
            THEN b.kind END AS kind
FROM public.notes b
WHERE (b.project_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('editor') AND r.scope_table = <projects>) AND ((b.kind <> 'private'::text)))
  AND NOT ((SELECT EXISTS (SELECT 1 FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('auditor') AND r.scope_table IS NULL)) AND (public.is_public(b.*)))
  AND ((b.project_id IN (SELECT r.scope_id::uuid FROM letter.memberships r WHERE r.user_id = letter._user_id() AND r.role IN ('editor') AND r.scope_table = <projects>) AND ((b.author = letter.user_id())))) IS NOT TRUE
CREATE VIEW v_notes WITH (security_barrier) AS :sql;
CREATE FUNCTION vc_parity(v regclass, tbl regclass, OUT mismatches bigint, OUT hidden_rows bigint)
LANGUAGE plpgsql AS $$
BEGIN
    EXECUTE format($q$
        WITH base AS (SELECT x.id, to_jsonb(x) AS j, letter.visible_columns(%L, x.id::text) AS vc FROM %s x),
        expect AS (
            SELECT id, (SELECT jsonb_object_agg(e.key, CASE WHEN e.key = ANY (vc) THEN e.value ELSE 'null'::jsonb END)
                        FROM jsonb_each(j) e) AS j
            FROM base WHERE vc IS NOT NULL),
        vw AS (SELECT x.id, to_jsonb(x) AS j FROM %s x)
        SELECT (SELECT count(*) FROM (SELECT * FROM expect EXCEPT SELECT * FROM vw) a)
             + (SELECT count(*) FROM (SELECT * FROM vw EXCEPT SELECT * FROM expect) b),
               (SELECT count(*) FROM base WHERE vc IS NULL)
    $q$, tbl, tbl, v) INTO mismatches, hidden_rows;
END $$;
